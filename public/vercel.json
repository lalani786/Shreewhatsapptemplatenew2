{
  "rewrites": [
    {
      "source": "/((?!assets/|favicon\\.ico|favicon\\.svg|logo\\.svg|placeholder\\.svg|robots\\.txt|google.*\\.html|ffmpeg/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
